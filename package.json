{
  "name": "ebm-agent-ts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript EBM research agent built on a vendored Pi coding-agent runtime.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:network": "bash scripts/smoke-deepseek.sh",
    "trace:analyze": "tsx scripts/analyze-trace.ts --markdown",
    "test:watch": "vitest",
    "postinstall": "patch-package",
    "ebm": "bash scripts/ebm.sh",
    "api": "tsx scripts/api-server.ts",
    "frontend:build": "npm --prefix frontend run build",
    "start": "npm run frontend:build && npm run api",
    "source-library:build": "tsx scripts/build-source-library.ts",
    "source-library:evaluate": "tsx scripts/evaluate-source-library.ts",
    "source-library:audit": "tsx scripts/audit-source-library.ts",
    "lint:boundaries": "tsx scripts/check-boundaries.ts",
    "check": "npm run typecheck && npm run test && npm run lint:boundaries"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "file:vendor/pi-coding-agent",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.3",
    "node-html-markdown": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "typebox": "^1.0.55",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
