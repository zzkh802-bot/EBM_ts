# EBM Agent OS 环境变量配置（示例）
# 复制为 .env 后填入实际密钥即可使用。
# 用哪个提供商默认由 config.yaml 的 provider 字段决定；也可在这里覆盖。
# EBM_PROVIDER=deepseek
# EBM_PROVIDER=xinqiong
# EBM_PROVIDER=dashscope

# ===== DeepSeek 原生 API（provider: "deepseek"，推荐）=====
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ===== OpenAI-compatible providers（provider: "xinqiong" / "dashscope"）=====
# Xinqiong 是服务提供商，其 DeepSeek V4 endpoint 使用 OPENAI_API_KEY。
OPENAI_API_KEY=sk-your-compatible-provider-key
DASHSCOPE_API_KEY=your-dashscope-key
# 高级覆盖：通常不需要填写，provider 会自动使用内置 endpoint
# XINQIONG_BASE_URL=https://cloud.infini-ai.com/maas/deepseek-v4-flash/nvidia
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== PubMed / NCBI（推荐 — API Key 提升限流至 10 req/s，Email 为 NCBI 必填）=====
NCBI_API_KEY=your-ncbi-api-key
NCBI_EMAIL=your-email@example.com

# ===== 网络搜索（推荐至少配置一个）=====
TAVILY_API_KEY=tvly-your-key
SERPER_API_KEY=your-serper-key
JINA_API_KEY=jina-your-key
FIRECRAWL_API_KEY=fc-your-key
# 中国大陆默认建议使用 .cn Reader/Search 入口
JINA_READER_BASE_URL=https://r.jinaai.cn
JINA_SEARCH_BASE_URL=https://s.jinaai.cn

# ===== 内部指南 MCP（可选；默认沿用 Python 项目地址）=====
# GUIDELINE_MCP_URL=http://172.20.252.15:8000/mcp
# GUIDELINE_MCP_TIMEOUT_MS=120000

# ===== 文档解析（可选）=====
MINERU_API_TOKEN=your-mineru-token
# MINERU_V4_BASE_URL=https://mineru.net/api/v4

# ===== 多模态视觉模型（可选）=====
# VISION_API_KEY=sk-your-vision-key
# 支持 glm-4.6v 等模型，用于图片分析兜底
# 注意按量计费，有配额限制

# ===== 飞书通知（可选）=====
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
FEISHU_SECRET=your-feishu-secret
