# Copy this file to .env. Never commit the populated .env.

# Required by the default model: deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Recommended for PubMed identity and higher NCBI rate limits.
NCBI_EMAIL=your-email@example.com
# NCBI_API_KEY=your-ncbi-api-key

# Recommended for public-web discovery. PubMed does not require this.
# TAVILY_API_KEY=tvly-your-key

# Optional page-reading fallbacks. Jina Reader also works without a key.
# JINA_API_KEY=jina-your-key
# JINA_READER_BASE_URL=https://r.jinaai.cn
# FIRECRAWL_API_KEY=fc-your-key

# Optional PDF parsing through MinerU Premium VLM.
# MINERU_API_TOKEN=your-mineru-token
# MINERU_V4_BASE_URL=https://mineru.net/api/v4

# Optional private/internal guideline MCP. Public users should leave this unset.
# GUIDELINE_MCP_URL=http://your-guideline-service/mcp
# GUIDELINE_MCP_TIMEOUT_MS=120000

# Optional Xinqiong OpenAI-compatible provider. Switch models inside the TUI with /model.
# OPENAI_API_KEY=sk-your-compatible-provider-key
# XINQIONG_BASE_URL=https://cloud.infini-ai.com/maas/deepseek-v4-flash/nvidia
